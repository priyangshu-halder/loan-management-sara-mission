datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches         Branch[]
  businessSettings BusinessSetting[]
  users            User[]
  roles            Role[]
  auditEvents      AuditEvent[]
  idempotencyKeys  IdempotencyRecord[]
  customers        Customer[]
  groups           Group[]
  customerGroups   CustomerGroup[]
  loanSchemes      LoanScheme[]
  loanApplications LoanApplication[]
  loanAccounts     LoanAccount[]
  repaymentInstallments RepaymentInstallment[]
  loanDisbursements LoanDisbursement[]
  loanClosures     LoanClosure[]
  savingsAccounts  SavingsAccount[]
  savingsTransactions SavingsTransaction[]
  depositProducts  DepositProduct[]
  termDepositAccounts TermDepositAccount[]
  rdInstallments   RdInstallment[]
  depositInterestPostings DepositInterestPosting[]
  collectionReceipts CollectionReceipt[]
  collectionAllocations CollectionReceiptAllocation[]
  collectionSheets CollectionSheet[]
  collectionSheetItems CollectionSheetItem[]
  followUps        FollowUp[]
  chartOfAccounts  ChartOfAccount[]
  fiscalPeriods    FiscalPeriod[]
  journalEntries   JournalEntry[]
  cashAccounts     CashAccount[]
  expenses         Expense[]
  expenseCategories ExpenseCategory[]
  masterCatalogItems MasterCatalogItem[]
  permissionProfiles PermissionProfile[]
  approvalHistories ApprovalHistory[]
  customerDocuments CustomerDocument[]
  dailyCashRecords DailyCashRecord[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userScopes     UserScope[]
  customers      Customer[]
  groups         Group[]
  collectionSheets CollectionSheet[]
  journalEntries JournalEntry[]
  cashAccounts   CashAccount[]
  expenses       Expense[]
  dailyCashRecords DailyCashRecord[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("branches")
}

model BusinessSetting {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  value          String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("business_settings")
}

model User {
  id                 String       @id @default(uuid())
  organizationId     String
  username           String
  email              String
  passwordHash       String
  fullName           String
  status             String       @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  mustChangePassword Boolean      @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles          UserRole[]
  userScopes         UserScope[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  auditEvents          AuditEvent[] @relation("ActorAuditEvents")
  postedJournalEntries JournalEntry[]
  closedFiscalPeriods  FiscalPeriod[] @relation("ClosedFiscalPeriods")
  permissionProfileId  String?
  permissionProfile    PermissionProfile? @relation(fields: [permissionProfileId], references: [id], onDelete: SetNull)
  userPermissions      UserPermission[]
  userPreferences      UserPreference[]
  makerApprovalHistories   ApprovalHistory[] @relation("ApprovalHistoryMaker")
  checkerApprovalHistories ApprovalHistory[] @relation("ApprovalHistoryChecker")
  finalizedDailyCashRecords DailyCashRecord[] @relation("DailyCashFinalizedBy")

  @@unique([organizationId, username])
  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String           @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles      UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  module          String
  description     String
  createdAt       DateTime         @default(now())

  rolePermissions    RolePermission[]
  userPermissions    UserPermission[]
  profilePermissions PermissionProfilePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserScope {
  id        String   @id @default(uuid())
  userId    String
  branchId  String?
  scopeType String   // ORGANIZATION, BRANCH
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([userId, branchId, scopeType])
  @@map("user_scopes")
}

model Customer {
  id                 String         @id @default(uuid())
  organizationId     String
  branchId           String?
  groupId            String
  customerCode       String
  fullName           String
  phone              String
  email              String?
  status             String         @default("ACTIVE")
  guardianName       String?
  dateOfBirth        DateTime?
  gender             String?
  aadhaarNumber      String?
  panNumber          String?
  occupation         String?
  residentialAddress String?        @db.Text
  nomineeName        String?
  guarantorName      String?
  passportPhoto      String?        @db.LongText
  aadhaarFrontDoc    String?        @db.LongText
  aadhaarBackDoc     String?        @db.LongText
  panPhoto           String?        @db.LongText

  // Personal and Family Details
  maritalStatus         String?
  familyMembers         Int?

  // Occupation and Financial Details
  primaryOccupation     String?
  communityId           String?
  educationId           String?
  annualIncome          Decimal?       @db.Decimal(19, 4)

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  group          Group          @relation("CustomerPrimaryGroup", fields: [groupId], references: [id], onDelete: Restrict)
  community      MasterCatalogItem? @relation("CustomerCommunity", fields: [communityId], references: [id], onDelete: SetNull)
  education      MasterCatalogItem? @relation("CustomerEducation", fields: [educationId], references: [id], onDelete: SetNull)
  customerGroups CustomerGroup[]
  documents      CustomerDocument[]
  collectionSheetItems CollectionSheetItem[]
  followUps        FollowUp[]
  loanApplications LoanApplication[]
  loanAccounts   LoanAccount[]
  savingsAccounts SavingsAccount[]
  termDepositAccounts TermDepositAccount[]

  @@unique([organizationId, customerCode])
  @@unique([organizationId, phone])
  @@index([organizationId, branchId, status])
  @@index([organizationId, groupId])
  @@index([organizationId, aadhaarNumber])
  @@index([organizationId, communityId])
  @@index([organizationId, educationId])
  @@map("customers")
}

model MasterCatalogItem {
  id             String       @id @default(uuid())
  organizationId String
  category       String       @db.VarChar(60)
  code           String       @db.VarChar(60)
  name           String       @db.VarChar(120)
  description    String?      @db.VarChar(255)
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customersWithCommunity Customer[] @relation("CustomerCommunity")
  customersWithEducation Customer[] @relation("CustomerEducation")

  @@unique([organizationId, category, code])
  @@index([organizationId, category, isActive])
  @@map("master_catalog_items")
}

model Group {
  id             String         @id @default(uuid())
  organizationId  String
  branchId       String?
  code           String
  name           String
  meetingDay     String?
  status         String         @default("ACTIVE")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customers      Customer[]     @relation("CustomerPrimaryGroup")
  customerGroups CustomerGroup[]
  collectionSheets CollectionSheet[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, branchId, status])
  @@map("groups")
}

model CustomerDocument {
  id             String       @id @default(uuid())
  organizationId String
  customerId     String
  documentType   String       // e.g. "APPLICATION_FORM"
  fileName       String
  storagePath    String
  mimeType       String
  fileSize       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, customerId])
  @@index([organizationId, documentType])
  @@map("customer_documents")
}

model CustomerGroup {
  id             String     @id @default(uuid())
  organizationId  String
  customerId     String
  groupId        String
  role           String     @default("MEMBER")
  status         String     @default("ACTIVE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  group          Group       @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([organizationId, customerId, groupId])
  @@index([organizationId, groupId, role])
  @@map("customer_groups")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@map("sessions")
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       String?      @db.Text
  ipAddress      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action, createdAt])
  @@map("audit_events")
}

model IdempotencyRecord {
  id              String       @id @default(uuid())
  organizationId  String
  operation       String
  idempotencyKey  String
  status          String       // PENDING, COMPLETED, FAILED
  responsePayload String?      @db.Text
  createdAt       DateTime     @default(now())
  expiresAt       DateTime

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isUsed])
  @@map("password_reset_tokens")
}

model LoanScheme {
  id             String            @id @default(uuid())
  organizationId  String
  code           String
  name           String
  status         String            @default("DRAFT")
  currentVersionId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions       LoanSchemeVersion[]
  applications   LoanApplication[]
  loanAccounts   LoanAccount[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("loan_schemes")
}

model LoanSchemeVersion {
  id                 String    @id @default(uuid())
  loanSchemeId       String
  versionNumber      Int
  principalAmount    String?   @db.VarChar(32)
  totalRepaymentAmount String? @db.VarChar(32)
  termMonths         Int
  termsAndConditions String?   @db.Text
  minPrincipal       String?   @db.VarChar(32)
  maxPrincipal       String?   @db.VarChar(32)
  interestRate       String?   @db.VarChar(32)
  interestMethod     String?
  repaymentFrequency String    @default("MONTHLY")
  gracePeriodDays    Int?      @default(0)
  status             String    @default("DRAFT")
  isPublished        Boolean   @default(false)
  effectiveDate      DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  loanScheme        LoanScheme @relation(fields: [loanSchemeId], references: [id], onDelete: Restrict)

  @@unique([loanSchemeId, versionNumber])
  @@index([loanSchemeId, status])
  @@map("loan_scheme_versions")
}

model LoanApplication {
  id                    String    @id @default(uuid())
  organizationId        String
  customerId           String
  schemeId             String
  requestedPrincipal   String    @db.VarChar(32)
  requestedTermMonths  Int
  totalRepaymentAmount String?   @db.VarChar(32)
  purpose              String
  status               String    @default("DRAFT")
  businessPurpose      String?
  approvalReason       String?
  rejectionReason      String?
  submittedAt          DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String?
  submittedById        String?
  approvedById         String?
  rejectedById        String?

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  scheme              LoanScheme  @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  disbursements       LoanDisbursement[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@map("loan_applications")
}

model LoanAccount {
  id                    String    @id @default(uuid())
  organizationId        String
  customerId           String
  schemeId             String
  loanAccountNumber    String
  principalDisbursed   String    @db.VarChar(32)
  principalOutstanding String    @db.VarChar(32)
  termMonths           Int?
  totalRepaymentAmount String?   @db.VarChar(32)
  totalPaid            String?   @default("0.0000") @db.VarChar(32)
  status               String    @default("ACTIVE")
  nextDueDate          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  scheme              LoanScheme  @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  disbursements       LoanDisbursement[]
  loanClosures        LoanClosure[]
  collectionReceipts  CollectionReceipt[]
  collectionReceiptAllocations CollectionReceiptAllocation[]
  installments        RepaymentInstallment[]
  collectionSheetItems CollectionSheetItem[]
  followUps           FollowUp[]

  @@unique([organizationId, loanAccountNumber])
  @@index([organizationId, customerId, status])
  @@map("loan_accounts")
}

model RepaymentInstallment {
  id                String       @id @default(uuid())
  organizationId    String
  loanAccountId     String
  installmentNumber Int
  dueDate           DateTime
  principalDue      Decimal      @db.Decimal(19, 4)
  interestDue       Decimal      @db.Decimal(19, 4)
  feeDue            Decimal      @default(0) @db.Decimal(19, 4)
  penaltyDue        Decimal      @default(0) @db.Decimal(19, 4)
  totalDue          Decimal      @db.Decimal(19, 4)
  principalPaid     Decimal      @default(0) @db.Decimal(19, 4)
  interestPaid      Decimal      @default(0) @db.Decimal(19, 4)
  feePaid           Decimal      @default(0) @db.Decimal(19, 4)
  penaltyPaid       Decimal      @default(0) @db.Decimal(19, 4)
  totalPaid         Decimal      @default(0) @db.Decimal(19, 4)
  status            String       @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loanAccount       LoanAccount  @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, loanAccountId, installmentNumber])
  @@index([organizationId, loanAccountId, dueDate, status])
  @@map("repayment_installments")
}

model LoanDisbursement {
  id                  String    @id @default(uuid())
  organizationId      String
  applicationId       String
  loanAccountId       String
  amount              String    @db.VarChar(32)
  disbursementDate    DateTime
  sourceReference     String
  status              String    @default("POSTED")
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  application         LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  loanAccount         LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, applicationId])
  @@index([organizationId, loanAccountId])
  @@map("loan_disbursements")
}

model LoanClosure {
  id                      String    @id @default(uuid())
  organizationId          String
  loanAccountId           String
  closureNumber           String?   @unique
  asOfDate                String
  principalOutstanding   String    @db.VarChar(32)
  accruedInterest        String    @db.VarChar(32)
  feeAmount              String    @db.VarChar(32)
  penaltyAmount          String    @db.VarChar(32)
  waiverAmount           String    @db.VarChar(32)
  waiverReason            String?
  totalSettlement        String    @db.VarChar(32)
  settlementPaymentAmount String?   @db.VarChar(32)
  cashAccountId           String?
  paymentMethod           String?
  journalEntryId          String?
  idempotencyKey          String?   @unique
  status                 String    @default("POSTED") // POSTED, REOPENED
  reason                 String
  createdById            String?
  isReopened              Boolean   @default(false)
  reopenedAt              DateTime?
  reopenedById            String?
  reopenReason            String?
  reopenJournalEntryId    String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loanAccount            LoanAccount  @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)
  cashAccount            CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, loanAccountId])
  @@index([organizationId, loanAccountId, asOfDate])
  @@map("loan_closures")
}

model SavingsAccount {
  id             String    @id @default(uuid())
  organizationId  String
  customerId     String
  accountNumber  String
  productName    String
  balance        String    @db.VarChar(32)
  minBalance     String    @default("0.0000") @db.VarChar(32)
  interestRate   String    @default("3.5000") @db.VarChar(32)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactions   SavingsTransaction[]
  interestPostings DepositInterestPosting[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId, customerId, status])
  @@map("savings_accounts")
}

model SavingsTransaction {
  id                     String    @id @default(uuid())
  organizationId          String
  accountId              String
  type                   String    // DEPOSIT, WITHDRAWAL, INTEREST
  amount                 String    @db.VarChar(32)
  balanceAfter           String    @db.VarChar(32)
  businessDate           String    @default("2026-10-23")
  cashAccountId          String?
  transactionRef         String
  journalEntryId         String?
  isReversed             Boolean   @default(false)
  reversedAt             DateTime?
  reversedById           String?
  reversalReason         String?
  reversalJournalEntryId String?
  note                   String?
  status                 String    @default("POSTED")
  createdAt              DateTime  @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account        SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  cashAccount    CashAccount?   @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, transactionRef])
  @@index([organizationId, accountId, createdAt])
  @@map("savings_transactions")
}

model DepositProduct {
  id                    String    @id @default(uuid())
  organizationId         String
  code                  String
  name                  String
  productType           String    // FD, RD
  interestRate          String    @db.VarChar(32)
  interestMethod        String    @default("SIMPLE") // SIMPLE, COMPOUND_ANNUAL, COMPOUND_QUARTERLY
  termMonths            Int
  minPrincipal          String    @db.VarChar(32)
  maxPrincipal          String    @db.VarChar(32)
  prematurePenaltyRate  String    @default("1.0000") @db.VarChar(32)
  installmentFrequency  String    @default("MONTHLY") // For RD
  status                String    @default("ACTIVE")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accounts       TermDepositAccount[]

  @@unique([organizationId, code])
  @@index([organizationId, productType, status])
  @@map("deposit_products")
}

model TermDepositAccount {
  id                     String    @id @default(uuid())
  organizationId         String
  customerId             String
  productId              String
  accountNumber          String
  principal              String    @db.VarChar(32)
  currentBalance         String    @default("0.0000") @db.VarChar(32)
  interestRate           String    @default("0.0000") @db.VarChar(32)
  depositDate            String    @default("2026-10-23")
  maturityDate           String
  projectedMaturityValue String    @default("0.0000") @db.VarChar(32)
  payoutInstruction      String    @default("PAYOUT_TO_SAVINGS") // PAYOUT_TO_SAVINGS, PAYOUT_TO_BANK, REINVEST
  cashAccountId          String?
  journalEntryId         String?
  closureJournalEntryId  String?
  closureDate            String?
  closureAmount          String?   @db.VarChar(32)
  closureReason          String?
  status                 String    @default("ACTIVE") // ACTIVE, MATURED, PREMATURE_CLOSED
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product        DepositProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  cashAccount    CashAccount?   @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  rdInstallments RdInstallment[]
  interestPostings DepositInterestPosting[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId, customerId, status])
  @@map("term_deposit_accounts")
}

model RdInstallment {
  id                String             @id @default(uuid())
  organizationId    String
  accountId         String
  installmentNumber Int
  dueDate           DateTime
  amountDue         Decimal            @db.Decimal(19, 4)
  amountPaid        Decimal            @default(0) @db.Decimal(19, 4)
  status            String             @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt            DateTime?
  receiptNumber     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account           TermDepositAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, accountId, installmentNumber])
  @@index([organizationId, accountId, dueDate, status])
  @@map("rd_installments")
}

model DepositInterestPosting {
  id               String              @id @default(uuid())
  organizationId   String
  savingsAccountId String?
  termAccountId    String?
  accountType      String              // SAVINGS, FD, RD
  accrualPeriod    String              // e.g. "2026-10"
  accrualKey       String              @unique @db.VarChar(120) // orgId:accountType:accountId:period
  calculationDate  String
  rateApplied      String              @db.VarChar(32)
  interestAmount   String              @db.VarChar(32)
  balanceBasis     String              @db.VarChar(32)
  journalEntryId   String?
  status           String              @default("POSTED") // POSTED, REVERSED
  isReversed       Boolean             @default(false)
  reversalReason   String?
  createdAt        DateTime            @default(now())

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  savingsAccount   SavingsAccount?     @relation(fields: [savingsAccountId], references: [id], onDelete: Restrict)
  termAccount      TermDepositAccount? @relation(fields: [termAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, accrualPeriod, status])
  @@map("deposit_interest_postings")
}

model CollectionReceipt {
  id             String    @id @default(uuid())
  organizationId  String
  loanAccountId  String
  cashAccountId  String
  receiptNumber  String
  businessDate   String
  amount         String    @db.VarChar(32)
  paymentMethod  String
  reference      String?
  status         String    @default("POSTED") // POSTED, REVERSED
  recordedById   String?
  journalEntryId String?
  isReversed     Boolean   @default(false)
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  reversalJournalEntryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loanAccount    LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)
  cashAccount    CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  allocations    CollectionReceiptAllocation[]
  sheetItems     CollectionSheetItem[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, loanAccountId, businessDate])
  @@map("collection_receipts")
}

model CollectionReceiptAllocation {
  id             String    @id @default(uuid())
  organizationId  String
  receiptId      String
  loanAccountId  String
  amount         String    @db.VarChar(32)
  allocationType String
  principalAmount String    @db.VarChar(32)
  interestAmount  String    @db.VarChar(32)
  feeAmount      String    @db.VarChar(32)
  penaltyAmount  String    @db.VarChar(32)
  status         String    @default("POSTED")
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receipt        CollectionReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  loanAccount    LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, loanAccountId, receiptId])
  @@map("collection_receipt_allocations")
}

model CollectionSheet {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String?
  groupId        String?
  sheetNumber    String
  businessDate   String
  totalExpected  Decimal   @db.Decimal(19, 4)
  totalCollected Decimal   @default(0) @db.Decimal(19, 4)
  status         String    @default("DRAFT") // DRAFT, IN_PROGRESS, SUBMITTED, RECONCILED
  generatedById  String?
  reconciledById String?
  reconciledAt   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  group          Group?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  items          CollectionSheetItem[]

  @@unique([organizationId, sheetNumber])
  @@index([organizationId, businessDate, status])
  @@map("collection_sheets")
}

model CollectionSheetItem {
  id                String    @id @default(uuid())
  organizationId    String
  collectionSheetId String
  loanAccountId     String
  customerId        String
  expectedAmount    Decimal   @db.Decimal(19, 4)
  collectedAmount   Decimal   @default(0) @db.Decimal(19, 4)
  status            String    @default("PENDING") // PENDING, COLLECTED, PARTIALLY_COLLECTED, MISSED
  receiptId         String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sheet             CollectionSheet @relation(fields: [collectionSheetId], references: [id], onDelete: Cascade)
  loanAccount       LoanAccount     @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receipt           CollectionReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([organizationId, collectionSheetId, status])
  @@index([organizationId, loanAccountId])
  @@map("collection_sheet_items")
}

model FollowUp {
  id             String    @id @default(uuid())
  organizationId String
  loanAccountId  String
  customerId     String
  followUpDate   DateTime  @default(now())
  dueDate        DateTime
  amountOverdue  Decimal   @db.Decimal(19, 4)
  daysPastDue    Int
  status         String    @default("PENDING") // PENDING, CONTACTED, PROMISE_TO_PAY, BROKEN_PROMISE, RESOLVED
  promiseDate    DateTime?
  promiseAmount  Decimal?  @db.Decimal(19, 4)
  notes          String    @db.Text
  officerId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loanAccount    LoanAccount  @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, loanAccountId, followUpDate])
  @@index([organizationId, customerId])
  @@map("loan_follow_ups")
}

model ChartOfAccount {
  id             String        @id @default(uuid())
  organizationId String
  code           String        // e.g. "1001", "2001", "4001"
  name           String
  accountType    String        // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  currency       String        @default("INR")
  description    String?
  isSystem       Boolean       @default(false)
  isActive       Boolean       @default(true)
  balance        Decimal       @default(0) @db.Decimal(19, 4)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalLines   JournalLine[]
  cashAccounts   CashAccount[]
  expenses       Expense[]
  expenseCategories ExpenseCategory[]

  @@unique([organizationId, code])
  @@index([organizationId, accountType])
  @@map("chart_of_accounts")
}

model FiscalPeriod {
  id             String       @id @default(uuid())
  organizationId String
  name           String       // e.g. "FY2026-Q1", "OCT-2026"
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean      @default(false)
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  closedBy       User?        @relation("ClosedFiscalPeriods", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId, isClosed])
  @@map("fiscal_periods")
}

model ExpenseCategory {
  id               String          @id @default(uuid())
  organizationId   String
  code             String          @db.VarChar(30)
  name             String          @db.VarChar(100)
  description      String?
  chartOfAccountId String?
  chartOfAccount   ChartOfAccount? @relation(fields: [chartOfAccountId], references: [id], onDelete: SetNull)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  expenses         Expense[]

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("expense_categories")
}

model Expense {
  id                     String           @id @default(uuid())
  organizationId         String
  branchId               String?
  voucherNumber          String           @default("") @db.VarChar(60)
  categoryId             String?
  category               String           @db.VarChar(80)
  chartOfAccountId       String?
  amount                 String           @db.VarChar(32)
  expenseDate            String
  payee                  String
  paymentMethod          String           // CASH, BANK_TRANSFER, CHEQUE, UPI
  description            String?
  supportingRef          String?
  status                 String           @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, POSTED, REVERSED
  
  attachmentFileName     String?
  attachmentStoragePath  String?
  attachmentMimeType     String?
  attachmentFileSize     Int?

  submittedById          String?
  submittedAt            DateTime?
  
  approvedById           String?
  approvedAt             DateTime?
  approvalReason         String?
  
  rejectedById           String?
  rejectedAt             DateTime?
  rejectionReason        String?
  
  cashAccountId          String?
  paymentReference       String?
  paidAt                 DateTime?
  postedById             String?
  journalEntryId         String?
  
  isReversed             Boolean          @default(false)
  reversedAt             DateTime?
  reversedById           String?
  reversalReason         String?
  reversalJournalEntryId String?

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                 Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  expenseCategory        ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  chartOfAccount         ChartOfAccount?  @relation(fields: [chartOfAccountId], references: [id], onDelete: SetNull)
  cashAccount            CashAccount?     @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expenseDate])
  @@index([organizationId, voucherNumber])
  @@map("expenses")
}

model JournalEntry {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String?
  entryNumber    String
  businessDate   String        // YYYY-MM-DD
  postingDate    DateTime
  sourceModule   String        // LOANS, COLLECTIONS, SAVINGS, EXPENSES, MANUAL
  sourceType     String        // DISBURSEMENT, COLLECTION_RECEIPT, SAVINGS_DEPOSIT, EXPENSE_PAYMENT, ADJUSTMENT
  sourceId       String?       // ID of operational entity
  description    String        @db.Text
  postedById     String?
  status         String        @default("POSTED") // POSTED, REVERSED
  reversalOfId   String?       @unique
  reversalReason String?
  totalDebit     Decimal       @db.Decimal(19, 4)
  totalCredit    Decimal       @db.Decimal(19, 4)
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  postedBy       User?         @relation(fields: [postedById], references: [id], onDelete: SetNull)
  lines          JournalLine[]
  reversalOf     JournalEntry? @relation("JournalReversals", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry? @relation("JournalReversals")

  @@unique([organizationId, entryNumber])
  @@index([organizationId, businessDate])
  @@index([organizationId, sourceModule, sourceId])
  @@index([organizationId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String         @id @default(uuid())
  journalEntryId String
  accountId      String
  lineNumber     Int
  debit          Decimal        @default(0) @db.Decimal(19, 4)
  credit         Decimal        @default(0) @db.Decimal(19, 4)
  narration      String?
  createdAt      DateTime       @default(now())

  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account        ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
  @@map("journal_lines")
}

model CashAccount {
  id               String         @id @default(uuid())
  organizationId   String
  branchId         String?
  chartOfAccountId String
  code             String         // e.g. "CASH-VAULT-01", "BANK-HDFC-01"
  name             String
  accountType      String         // CASH, BANK
  balance          Decimal        @default(0) @db.Decimal(19, 4)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)
  collectionReceipts CollectionReceipt[]
  loanClosures     LoanClosure[]
  savingsTransactions SavingsTransaction[]
  termDepositAccounts TermDepositAccount[]
  expenses         Expense[]
  dailyCashRecords DailyCashRecord[]

  @@unique([organizationId, code])
  @@index([organizationId, branchId])
  @@map("cash_accounts")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_preferences")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model PermissionProfile {
  id             String                      @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  isSystem       Boolean                     @default(false)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profilePermissions PermissionProfilePermission[]
  users          User[]

  @@unique([organizationId, code])
  @@map("permission_profiles")
}

model PermissionProfilePermission {
  id           String            @id @default(uuid())
  profileId    String
  permissionId String
  createdAt    DateTime          @default(now())

  profile      PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permission   Permission        @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([profileId, permissionId])
  @@map("permission_profile_permissions")
}

model ApprovalHistory {
  id             String       @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  action         String
  statusBefore   String?
  statusAfter    String
  makerId        String?
  checkerId      String?
  comments       String?      @db.Text
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  maker          User?        @relation("ApprovalHistoryMaker", fields: [makerId], references: [id], onDelete: SetNull)
  checker        User?        @relation("ApprovalHistoryChecker", fields: [checkerId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, checkerId])
  @@map("approval_history")
}

model DailyCashRecord {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String?
  cashAccountId  String
  businessDate   String       // YYYY-MM-DD
  openingBalance Decimal      @db.Decimal(19, 4)
  totalReceived  Decimal      @db.Decimal(19, 4)
  totalPayment   Decimal      @db.Decimal(19, 4)
  closingBalance Decimal      @db.Decimal(19, 4)
  isFinalized    Boolean      @default(false)
  isInitial      Boolean      @default(false)
  finalizedAt    DateTime?
  finalizedById  String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashAccount    CashAccount  @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  finalizedBy    User?        @relation("DailyCashFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, cashAccountId, businessDate])
  @@index([organizationId, businessDate])
  @@index([organizationId, cashAccountId])
  @@map("daily_cash_records")
}


